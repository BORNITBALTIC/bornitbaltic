# Railway Postgres (tootmine). Kohalikult voib tyhjaks jatta, siis kasutatakse SQLitet.
DATABASE_URI=

# Payloadi krypteerimisvoti. Genereeri: openssl rand -hex 32
PAYLOAD_SECRET=

# Avalik aadress (Railway domeen voi https://bornitbaltic.ee)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Arenduses teeb Payload skeemi ise. Tootmises kaib skeem migratsioonidega:
#   npx payload migrate:create --name mis-muutus
PAYLOAD_DB_PUSH=false

# Failide kaust. Railway peal seo volume'iga, nt /app/media
MEDIA_DIR=

# Paringuvormi meil
INQUIRY_TO=marek@bornitbaltic.ee
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
